<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow backend API routes and uploaded media to pass through
  RewriteCond %{REQUEST_URI} ^/backend/ [NC]
  RewriteRule ^ - [L]

  # 2. If requested file or directory exists (assets, favicon, illustrations), serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback all SPA routes to index.html for React Router / SPA navigation
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# ⚡ LiteSpeed & Apache High-Performance Caching (Hostinger Optimized)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Vite Hashed JS, CSS, and Fonts (Immutable for 1 Year)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Images & Media
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # HTML & JSON (Always fresh)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Enable Gzip / Brotli Compression
  Header append Vary Accept-Encoding

  # Cache Hashed Vite Assets with Immutable Directive
  <FilesMatch "\.(js|css|woff2|woff|webp|png|svg|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML & API: Never cache in browser
  <FilesMatch "\.(html|json|php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
